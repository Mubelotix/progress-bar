# Records media/demo.gif with VHS (https://github.com/charmbracelet/vhs).
# Regenerated by .github/workflows/demo.yml, or locally with: vhs media/demo.tape

Output media/demo.gif

Set Shell "bash"
Set FontSize 16
Set Width 1100
Set Height 240
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set WaitTimeout 5m

# Build beforehand so that compilation doesn't show up in the recording
Hide
Type "export PS1='$ ' && cargo build -q --example demo && clear"
Enter
Wait /\$$/
Show

Type "cargo run -q --example demo"
Sleep 300ms
Enter
Wait /\$$/
Sleep 3s
